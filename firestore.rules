rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 予約：作成は誰でも可、読み取り・更新・削除は管理者のみ
    match /reservations/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // シフト：読み取りは誰でも可（予約フォーム表示に必要）、書き込みは管理者のみ
    match /shifts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 保育士：読み取りは誰でも可（予約フォーム表示に必要）、書き込みは管理者のみ
    match /nurses/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 来園回数・クーポン：予約作成時に更新が必要なため作成・更新は許可、読み取り・削除は管理者のみ
    match /visitCounts/{id} {
      allow create, update: if true;
      allow read, delete: if request.auth != null;
    }
    match /coupons/{id} {
      allow create, update: if true;
      allow read, delete: if request.auth != null;
    }
  }
}
