rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reservations/{id} {
      allow read, write: if true;
    }
    match /shifts/{id} {
      allow read, write: if true;
    }
    match /nurses/{id} {
      allow read, write: if true;
    }
    match /visitCounts/{id} {
      allow read, write: if true;
    }
    match /coupons/{id} {
      allow read, write: if true;
    }
  }
}
