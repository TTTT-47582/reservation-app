rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 予約：作成は誰でも可（フィールド検証あり）、読み取り・更新・削除は管理者のみ
    match /reservations/{id} {
      allow create: if
        request.resource.data.parentName is string &&
        request.resource.data.parentName.size() > 0 &&
        request.resource.data.parentName.size() <= 50 &&
        request.resource.data.childName is string &&
        request.resource.data.childName.size() > 0 &&
        request.resource.data.childName.size() <= 50 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 10 &&
        request.resource.data.phone.size() <= 20 &&
        request.resource.data.date is string &&
        request.resource.data.date.size() == 10 &&
        request.resource.data.timeSlot is string &&
        request.resource.data.timeSlot.size() > 0 &&
        request.resource.data.timeSlot.size() <= 20 &&
        (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 500) &&
        (!('purpose' in request.resource.data) || request.resource.data.purpose.size() <= 200);
      allow read, update, delete: if request.auth != null;
    }

    // シフト：読み取りは誰でも可（予約フォーム表示に必要）、書き込みは管理者のみ
    match /shifts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 保育士：読み取りは誰でも可（予約フォーム表示に必要）、書き込みは管理者のみ
    match /nurses/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 来園回数：予約作成・更新は誰でも可、読み取りも可（カウント確認に必要）、削除は管理者のみ
    match /visitCounts/{id} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // クーポン：読み取り・作成・更新は誰でも可（フォームでの検証に必要）、削除は管理者のみ
    match /coupons/{id} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // 休園日：読み取りは誰でも可（予約フォーム表示に必要）、書き込みは管理者のみ
    match /closedDates/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 写真アルバム：読み取りは誰でも可（保護者がPIN認証後に閲覧）、書き込みは管理者のみ
    match /photoAlbums/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
