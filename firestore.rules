rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 予約：作成は誰でも可、読み取り・更新・削除は管理者のみ
    match /reservations/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // シフト：読み取りは誰でも可（予約フォーム表示に必要）、書き込みは管理者のみ
    match /shifts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 保育士：読み取りは誰でも可（予約フォーム表示に必要）、書き込みは管理者のみ
    match /nurses/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 来園回数：予約作成・更新は誰でも可、読み取りも可（カウント確認に必要）、削除は管理者のみ
    match /visitCounts/{id} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }
    // クーポン：読み取り・作成・更新は誰でも可（フォームでの検証に必要）、削除は管理者のみ
    match /coupons/{id} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // 休園日：読み取りは誰でも可（予約フォーム表示に必要）、書き込みは管理者のみ
    match /closedDates/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 写真アルバム：読み取りは誰でも可（保護者がPIN認証後に閲覧）、書き込みは管理者のみ
    match /photoAlbums/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
